{
  "name": "@aletheia-ios/tools",
  "version": "0.2.1",
  "description": "The aletheia CLI: build, check, pack, index and serve source packages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aletheia-ios/tools.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aletheia": "./dist/cli.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsdown && chmod +x dist/cli.js",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test && publint",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aletheia-ios/sdk": "^0.4.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "lefthook": "^2.1.12",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
